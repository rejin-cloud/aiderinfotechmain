# Disable directory indexing to prevent 403 Forbidden errors on folder access
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # =====================================================================
  # 1. CLEANUP OLD WORDPRESS URLS (Remove "Hello World", "Astra", etc. from Google)
  # Redirect old WP paths to home page (301 Permanent Redirect)
  # =====================================================================
  RewriteCond %{QUERY_STRING} (^|&)p= [NC,OR]
  RewriteCond %{REQUEST_URI} ^/(hello-world|sample-page|wp-login|wp-admin|wp-content|wp-includes|feed|comments) [NC]
  RewriteRule ^(.*)$ /? [R=301,L]

  # =====================================================================
  # 2. STATIC ASSET & ROUTING DIRECT ACCESS
  # Direct access for _next, images, and js
  # =====================================================================
  RewriteCond %{REQUEST_URI} ^/(_next|images|js)/ [NC]
  RewriteRule ^ - [L]

  # Serve existing files directly (favicon.ico, sitemap.xml, robots.txt)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # =====================================================================
  # 3. CLEAN SUBPAGE ROUTING (Prevents 403 Forbidden on /about, /services, etc.)
  # /about -> /about/index.html
  # =====================================================================
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # /about -> /about.html fallback
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Serve directory index.html if directory is accessed
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ %{REQUEST_FILENAME}/index.html [L]

  # Custom 404 page handler
  ErrorDocument 404 /404.html
</IfModule>

# Enable Browser Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Enable Compression (Gzip / Deflate)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
